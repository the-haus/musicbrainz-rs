{
  "name": "@musicbrainz-rs/node",
  "version": "0.2.0",
  "description": "MusicBrainz full exports as DuckDB databases in Node.js: built from mbdump.tar.bz2 in one pass (parallel bzip2, Rust), refreshed with a diff of what changed, queried with SQL and batched lookups.",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "yarn@4.5.1",
  "homepage": "https://github.com/the-haus/musicbrainz-rs/tree/main/crates/bindings/musicbrainz-node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-haus/musicbrainz-rs.git",
    "directory": "crates/bindings/musicbrainz-node"
  },
  "keywords": [
    "musicbrainz",
    "metabrainz",
    "duckdb",
    "dump",
    "bzip2",
    "database",
    "napi",
    "rust"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "musicbrainz-node.*.node",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "napi": {
    "name": "musicbrainz-node",
    "package": {
      "name": "@musicbrainz-rs/node"
    },
    "triples": {
      "defaults": false,
      "additional": [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl",
        "aarch64-unknown-linux-musl",
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "x86_64-pc-windows-msvc"
      ]
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:native": "napi build --platform --release --js false --dts native.generated.d.ts",
    "build:native:debug": "napi build --platform --js false --dts native.generated.d.ts",
    "build:ts": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json && node scripts/copy-native.mjs",
    "build": "yarn run build:native && yarn run build:ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "artifacts": "napi artifacts",
    "create-npm-dirs": "napi create-npm-dir -t .",
    "copy-license": "node -e \"const fs=require('fs');fs.copyFileSync('../../../LICENCE.txt','LICENSE');fs.copyFileSync('../../../CHANGELOG.md','CHANGELOG.md')\""
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4",
    "@types/node": "^22.7.4",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
